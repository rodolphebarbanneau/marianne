{
  "name": "marianne",
  "productName": "Marianne",
  "version": "0.1.0-alpha.1",
  "description": "Assistant citoyen : vos droits, vos démarches et les données publiques françaises, avec votre propre Claude Code, Codex ou Mistral Vibe.",
  "main": "./out/main/index.js",
  "author": "Rodolphe Barbanneau",
  "license": "MIT",
  "homepage": "https://github.com/rodolphebarbanneau/marianne",
  "repository": {
    "type": "git",
    "url": "https://github.com/rodolphebarbanneau/marianne.git",
    "directory": "apps/desktop"
  },
  "private": true,
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "icons": "node scripts/generate-icons.mjs",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "@zxcvbn-ts/language-fr": "^4.1.2",
    "electron-updater": "^6.8.11",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "pdfjs-dist": "^6.4.299",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@marianne/content": "*",
    "@marianne/sdk": "*",
    "@marianne/service-annuaire": "*",
    "@marianne/service-assemblee": "*",
    "@marianne/service-carte": "*",
    "@marianne/service-meteo": "*",
    "@marianne/service-peage": "*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "vite": "^8.3.5"
  }
}
