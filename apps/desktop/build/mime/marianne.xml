<?xml version="1.0" encoding="UTF-8"?>
<!-- The .marianne type on Linux, installed by the .deb (electron-builder.yml): its name, its files, its icon
     (application-x-marianne, in the hicolor theme). An archive is an SQLite file: as a subclass, the name wins. -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-marianne">
    <comment>Archive Marianne</comment>
    <sub-class-of type="application/vnd.sqlite3"/>
    <glob pattern="*.marianne"/>
    <icon name="application-x-marianne"/>
  </mime-type>
</mime-info>
