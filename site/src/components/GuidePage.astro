---
import { render } from 'astro:content'
import Base from '../layouts/Base.astro'
import GuideContents from './GuideContents.astro'
import { localized, words, type Lang } from '../i18n'
import type { GuidePage as Page } from '../lib/guide'

interface Props {
  lang: Lang
  pages: Page[]
  page: Page
}
const { lang, pages, page } = Astro.props
const t = words(lang)
const { Content, headings } = await render(page.entry)
const at = pages.indexOf(page)
const prev = pages[at - 1]
const next = pages[at + 1]
const sections = headings.filter((h) => h.depth === 2)
const source = `https://github.com/rodolphebarbanneau/marianne/blob/main/docs/guide/${page.entry.id}.md`
---

<Base
  lang={lang}
  path={`guide/${page.slug ? page.slug + '/' : ''}`}
  title={`${page.title} · ${t.guide.title}`}
  description={page.summary || undefined}
  prev={prev ? { href: prev.href, label: prev.title } : { href: localized(lang), label: t.guide.back }}
  next={next ? { href: next.href, label: next.title } : undefined}
>
  <div class="wrap guide">
    <aside class="side">
      <p class="label">{t.guide.title}</p>
      <ol>
        {pages.map((p, i) => (
          <li>
            <a href={p.href} class:list={{ on: p === page }} aria-current={p === page ? 'page' : undefined}>
              <span class="n">{i === 0 ? '·' : i}</span>
              {i === 0 ? t.guide.contents : p.title}
            </a>
            {p === page && sections.length > 0 && (
              <ul>
                {sections.map((h) => (
                  <li>
                    <a href={`#${h.slug}`} data-toc={h.slug}>
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ol>
    </aside>

    <article class="prose">
      <Content />
      {at === 0 && (
        <div class="index-contents">
          <GuideContents pages={pages} />
        </div>
      )}
      <nav class="pager">
        {prev ? (
          <a href={prev.href} rel="prev">
            <span class="key">{t.guide.prev}</span> {at === 1 ? t.guide.contents : prev.title}
          </a>
        ) : (
          <span />
        )}
        {next && (
          <a href={next.href} rel="next">
            {next.title} <span class="key">{t.guide.next}</span>
          </a>
        )}
      </nav>
      <p class="edit">
        <a href={source}>{t.guide.edit} ›</a>
      </p>
    </article>
  </div>
</Base>

<script>
  // The section being read, lit in the page's contents as the page scrolls: the last one whose
  // title has gone past the top of the screen (under the header), the first one before that, and the
  // last one once the page can't scroll any further.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.side [data-toc]')]
  const headings = links.map((a) => document.getElementById(a.dataset.toc!)).filter((h): h is HTMLElement => !!h)
  if (headings.length) {
    let frame = 0
    const update = () => {
      frame = 0
      const top = ((document.querySelector('.top') as HTMLElement | null)?.offsetHeight ?? 0) + 24
      const atEnd = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4
      let current = 0
      headings.forEach((h, i) => {
        if (h.getBoundingClientRect().top <= top) current = i
      })
      if (atEnd) current = headings.length - 1
      links.forEach((a, i) => {
        a.classList.toggle('on', i === current)
        if (i === current) a.setAttribute('aria-current', 'location')
        else a.removeAttribute('aria-current')
      })
    }
    addEventListener('scroll', () => (frame ||= requestAnimationFrame(update)), { passive: true })
    addEventListener('resize', update)
    update()
  }
</script>

<style>
  .guide {
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr);
    gap: clamp(28px, 5vw, 64px);
    padding-top: 48px;
    align-items: start;
  }
  .side {
    position: sticky;
    top: calc(var(--header-h) + 28px);
    font-size: 0.92rem;
  }
  .side ol,
  .side ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .side .label {
    margin-bottom: 12px;
  }
  .side ol > li > a {
    display: flex;
    gap: 10px;
    padding: 5px 8px;
    color: var(--dim);
  }
  .side ol > li > a:hover {
    color: var(--hi);
    background: var(--hover);
  }
  .side ol > li > a.on {
    background: var(--sel);
    color: var(--hi);
  }
  .side .n {
    font-family: var(--retro);
    font-size: 1.2rem;
    line-height: 1.2;
    min-width: 1ch;
    color: var(--accent);
  }
  .side ul {
    margin: 4px 0 10px 18px;
    border-left: 1px solid var(--rule);
  }
  .side ul a {
    display: block;
    padding: 3px 12px;
    color: var(--dim);
    font-size: 0.85rem;
  }
  .side ul a:hover {
    color: var(--accent);
  }
  /* The section being read: its words lit, a yellow bar over the list's rule. */
  .side ul a.on {
    color: var(--hi);
    box-shadow: inset 2px 0 0 var(--accent);
    margin-left: -1px;
    padding-left: 13px;
  }

  /* The guide's text: the app's monospace screen, its titles in the pixel font. */
  .prose {
    max-width: 78ch;
    color: var(--fg);
  }
  .prose :global(h1) {
    font-family: var(--retro);
    font-size: clamp(2.8rem, 6vw, 4.2rem);
    line-height: 1;
    color: var(--hi);
    margin-bottom: 28px;
  }
  .prose :global(h2) {
    font-family: var(--retro);
    font-size: 2rem;
    line-height: 1.1;
    color: var(--hi);
    margin: 48px 0 14px;
    padding-top: 14px;
    border-top: 1px solid var(--rule);
  }
  .prose :global(h3) {
    color: var(--hi);
    font-weight: 500;
    margin: 28px 0 10px;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(table) {
    margin: 0 0 16px;
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.4em;
  }
  .prose :global(li) {
    margin-bottom: 8px;
  }
  .prose :global(li::marker) {
    color: var(--accent);
  }
  .prose :global(strong) {
    color: var(--hi);
    font-weight: 600;
  }
  .prose :global(code) {
    font-family: var(--sharp);
    background: var(--bg-raised);
    border: 1px solid var(--rule);
    padding: 0 5px;
    color: var(--accent);
    font-size: 0.92em;
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }
  .prose :global(th) {
    text-align: left;
    font-weight: 400;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
    border-bottom: 1px solid var(--rule);
    padding: 8px 10px;
  }
  .prose :global(td) {
    border-bottom: 1px solid var(--rule);
    padding: 8px 10px;
  }
  /* The keys of the table of keys, in the pixel font, as the app's bottom bar shows them. */
  .prose :global(td:first-child) {
    font-family: var(--retro);
    font-size: 1.2rem;
    color: var(--hi);
  }
  .prose :global(a) {
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--link) 40%, transparent);
    text-underline-offset: 3px;
  }
  .index-contents {
    margin-top: 36px;
  }
  .index-contents :global(a) {
    text-decoration: none;
  }
  .pager {
    margin-top: 56px;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .pager a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--fg);
    text-decoration: none;
  }
  .pager a:hover {
    color: var(--hi);
  }
  .pager a:hover .key {
    background: var(--accent);
  }
  .pager .key {
    font-size: 1.15rem;
  }
  .edit {
    margin-top: 28px;
    font-size: 0.85rem;
  }
  .edit a {
    color: var(--dim);
    text-decoration: none;
  }
  @media (max-width: 860px) {
    .guide {
      grid-template-columns: 1fr;
    }
    .side {
      position: static;
    }
    .side ul {
      display: none;
    }
  }
</style>
