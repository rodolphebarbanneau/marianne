---
import { localized, words, type Lang } from '../i18n'

/**
 * The app's bottom bar: the lock, the engines' lights, and the Minitel keys of the screen. Here the
 * keys work too: RETOUR and SUITE go to the section (or the guide's page) before and after, SOMMAIRE
 * to the top, GUIDE to the guide.
 */
interface Props {
  lang: Lang
  prev?: { href: string; label: string }
  next?: { href: string; label: string }
}
const { lang, prev, next } = Astro.props
const t = words(lang)
const pages = !!(prev || next)
---

<div class="keysbar" aria-label="Minitel">
  <span class="lock">
    <svg viewBox="0 0 16 16" aria-hidden="true">
      <path d="M4.5 7V5a3.5 3.5 0 0 1 7 0v2M3.5 7h9v7h-9z" fill="none" stroke="currentColor" stroke-width="1.4"></path>
    </svg>
    <span class="what">{t.bar.locked}</span>
  </span>
  <span class="lights" aria-hidden="true">
    <span class="light">CL</span>
    <span class="light">CX</span>
    <span class="light soon">MI</span>
  </span>
  <nav class="keys">
    {pages ? (
      <>
        {prev && (
          <a href={prev.href} rel="prev">
            <span class="key">RETOUR</span> <span class="what">{prev.label}</span>
          </a>
        )}
        {next && (
          <a href={next.href} rel="next">
            <span class="key">SUITE</span> <span class="what">{next.label}</span>
          </a>
        )}
      </>
    ) : (
      <>
        <button type="button" data-go="-1">
          <span class="key">RETOUR</span> <span class="what">{t.bar.prev}</span> <span class="sc">pg↑</span>
        </button>
        <button type="button" data-go="1">
          <span class="key">SUITE</span> <span class="what">{t.bar.next}</span> <span class="sc">pg↓</span>
        </button>
      </>
    )}
    <a href="#">
      <span class="key">SOMMAIRE</span> <span class="what">{t.bar.top}</span>
    </a>
    <a href={localized(lang, 'guide/')}>
      <span class="key">GUIDE</span> <span class="what">{t.bar.help}</span>
    </a>
  </nav>
</div>

<script>
  // RETOUR and SUITE: the section above or below the one at the top of the screen.
  const sections = () => [...document.querySelectorAll<HTMLElement>('main [data-section]')]
  document.querySelectorAll<HTMLButtonElement>('.keysbar [data-go]').forEach((b) =>
    b.addEventListener('click', () => {
      const go = Number(b.dataset.go)
      const top = (document.querySelector('.top') as HTMLElement | null)?.offsetHeight ?? 0
      const list = sections()
      const y = window.scrollY + top + 16
      const target = go > 0 ? list.find((s) => s.offsetTop > y + 4) : [...list].reverse().find((s) => s.offsetTop < y - 4)
      if (target) target.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' })
      else if (go < 0) window.scrollTo({ top: 0, behavior: 'smooth' })
    })
  )
</script>

<style>
  .keysbar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    height: var(--bar-h);
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 0 14px;
    background: #0a0e2c;
    border-top: 1px solid var(--rule);
    font-size: 0.86rem;
  }
  html[data-theme='monochrome'] .keysbar {
    background: var(--bg-raised);
  }
  .lock {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--dim);
  }
  .lock svg {
    width: 15px;
    height: 15px;
  }
  .lights {
    display: inline-flex;
    gap: 6px;
  }
  .light {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 0 5px;
    border: 1px solid var(--muted);
    color: var(--fg);
    font-size: 0.75rem;
    line-height: 1.4;
  }
  .light::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--vert);
  }
  .light.soon::before {
    background: linear-gradient(90deg, var(--vert) 50%, transparent 50%);
    box-shadow: inset 0 0 0 1px var(--vert);
  }
  .keys {
    margin-left: auto;
    display: flex;
    gap: 16px;
    min-width: 0;
  }
  .keys a,
  .keys button {
    all: unset;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--dim);
    cursor: pointer;
    white-space: nowrap;
  }
  .keys a:hover .key,
  .keys button:hover .key {
    background: var(--accent);
  }
  .keys a:focus-visible,
  .keys button:focus-visible {
    outline: 1px solid var(--accent);
    outline-offset: 2px;
  }
  .key {
    font-size: 1.12rem;
    line-height: 1.15;
  }
  @media (max-width: 1100px) {
    .keys .what,
    .keys .sc {
      display: none;
    }
  }
  @media (max-width: 720px) {
    .keysbar {
      display: none;
    }
  }
</style>
