---
import { localized, words, type Lang } from '../i18n'

interface Props {
  lang: Lang
  path: string
}
const { lang, path } = Astro.props
const t = words(lang)
const other: Lang = lang === 'fr' ? 'en' : 'fr'
const home = localized(lang)
const GH = 'https://github.com/rodolphebarbanneau/marianne'
// The home page's sections; from another page, the same links lead back to them. Then the site's own
// pages: the same path in each language. `fits`: down to which width a tab stays in the header as it
// narrows (wide, medium, or any); the menu always holds them all.
const onHome = path === ''
const tabs = [
  ...[
    { id: 'fonctions', label: t.nav.features, fits: 'wide' },
    { id: 'vie-privee', label: t.nav.privacy, fits: 'wide' },
    { id: 'services', label: t.nav.services, fits: 'wide' },
    { id: 'telecharger', label: t.nav.download, fits: 'medium' }
  ].map((l) => ({ ...l, href: onHome ? `#${l.id}` : `${home}#${l.id}`, spy: onHome ? l.id : undefined, current: false })),
  ...[
    { path: 'guide/', label: t.nav.guide, fits: 'any' },
    { path: 'manifeste/', label: t.nav.manifesto, fits: 'medium' }
  ].map((p) => ({ ...p, href: localized(lang, p.path), spy: undefined, current: path.startsWith(p.path) }))
]
---

<header class="top">
  <div class="bar wrap">
    <a class="mark" href={home} aria-label="Marianne">
      <span class="wordmark">MARIANNE</span>
    </a>
    <nav class="tabs" aria-label="Sections">
      {tabs.map((tab) => (
        <a
          href={tab.href}
          class:list={{ on: tab.current }}
          aria-current={tab.current ? 'page' : undefined}
          data-spy={tab.spy}
          data-fits={tab.fits}
        >
          {tab.label}
        </a>
      ))}
    </nav>
    <div class="tools">
      <button type="button" class="opt" data-opt="mono" title={t.ui.monoTitle} aria-pressed="false">
        {t.ui.mono}
      </button>
      <a class="lang" href={localized(other, path)} hreflang={other} lang={other} title={t.ui.otherTitle}>
        {other.toUpperCase()}
      </a>
      <a class="gh" href={GH} aria-label="GitHub">
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <path
            fill="currentColor"
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
          ></path>
        </svg>
      </a>
      <button type="button" class="menu-key" aria-label={t.ui.menu} aria-expanded="false" aria-controls="menu">
        <span class="key">MENU</span>
      </button>
    </div>
  </div>
  <nav id="menu" class="menu" aria-label={t.ui.menu} hidden>
    <ol>
      {tabs.map((tab, i) => (
        <li>
          <a href={tab.href} class:list={{ on: tab.current }} aria-current={tab.current ? 'page' : undefined} data-spy={tab.spy}>
            <span class="n inv">{i + 1}</span>
            {tab.label}
          </a>
        </li>
      ))}
    </ol>
    <div class="more">
      <button type="button" class="opt" data-opt="mono" title={t.ui.monoTitle} aria-pressed="false">
        {t.ui.mono}
      </button>
      <a class="repo" href={GH}>GitHub ›</a>
    </div>
  </nav>
</header>

<script>
  // Minitel 1, the first Minitel's greys: an option kept between visits.
  const root = document.documentElement
  const monos = [...document.querySelectorAll<HTMLButtonElement>('.opt[data-opt="mono"]')]
  const read = () => {
    try {
      return !!JSON.parse(localStorage.getItem('marianne-screen') || '{}').mono
    } catch {
      return false
    }
  }
  const apply = (on: boolean) => {
    if (on) root.dataset.theme = 'monochrome'
    else delete root.dataset.theme
    monos.forEach((m) => m.setAttribute('aria-pressed', String(on)))
  }
  monos.forEach((m) =>
    m.addEventListener('click', () => {
      const on = !read()
      localStorage.setItem('marianne-screen', JSON.stringify({ mono: on }))
      apply(on)
    })
  )
  apply(read())

  // MENU: its links close it, since one of the page's own sections doesn't load a new page; so do
  // échap and a tap beside it.
  const header = document.querySelector<HTMLElement>('header.top')!
  const key = header.querySelector<HTMLButtonElement>('.menu-key')!
  const menu = header.querySelector<HTMLElement>('.menu')!
  const open = (on: boolean) => {
    menu.hidden = !on
    key.setAttribute('aria-expanded', String(on))
  }
  key.addEventListener('click', () => open(key.getAttribute('aria-expanded') !== 'true'))
  menu.addEventListener('click', (e) => {
    if ((e.target as Element).closest('a')) open(false)
  })
  document.addEventListener('click', (e) => {
    if (!header.contains(e.target as Node)) open(false)
  })
  addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu.hidden) {
      open(false)
      key.focus()
    }
  })

  // The current section's tab in inverse video, as the app shows the current page.
  const spies = [...document.querySelectorAll<HTMLAnchorElement>('[data-spy]')]
  const sections = [...new Set(spies.map((a) => a.dataset.spy!))].map((id) => document.getElementById(id)).filter((s): s is HTMLElement => !!s)
  if (sections.length) {
    const update = () => {
      const y = window.scrollY + window.innerHeight * 0.35
      let current: string | undefined
      for (const s of sections) if (s.offsetTop <= y) current = s.id
      spies.forEach((a) => a.classList.toggle('on', a.dataset.spy === current))
    }
    addEventListener('scroll', update, { passive: true })
    update()
  }
</script>

<style>
  /* Every control at the header's end has one height: --ctl, more under a finger. */
  .top {
    --ctl: 32px;
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--rule);
  }
  .bar {
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: 20px;
  }
  /* The name on the left; the tabs, then the tools, on the right. */
  .mark {
    margin-right: auto;
    color: var(--hi);
    padding: 10px 0;
  }
  .mark .wordmark {
    font-size: 1.5rem;
  }
  .mark:hover .wordmark {
    color: var(--accent);
  }
  .tabs {
    display: flex;
    align-items: center;
    gap: 2px;
  }
  .tabs a {
    display: inline-flex;
    align-items: center;
    height: var(--ctl);
    padding: 0 10px;
    color: var(--dim);
  }
  .tabs a:hover {
    color: var(--hi);
  }
  .tabs a.on {
    background: var(--accent);
    color: var(--noir);
  }
  /* A rule between the tabs and the tools, where there are tabs. */
  .tools {
    display: flex;
    align-items: center;
    gap: 6px;
    padding-left: 20px;
    border-left: 1px solid var(--rule);
  }
  .opt,
  .lang {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: var(--ctl);
    min-width: var(--ctl);
    font: inherit;
    font-size: 0.8rem;
    line-height: 1;
    padding: 0 10px;
    border: 1px dashed var(--rule);
    background: none;
    color: var(--dim);
    cursor: pointer;
  }
  .opt:hover,
  .lang:hover {
    color: var(--hi);
    border-color: var(--bleu);
  }
  .opt[aria-pressed='true'] {
    border-style: solid;
    border-color: var(--accent);
    color: var(--accent);
  }
  .lang {
    border-style: solid;
  }
  .gh {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--ctl);
    height: var(--ctl);
    color: var(--dim);
  }
  .gh:hover {
    color: var(--hi);
  }
  .gh svg {
    width: 20px;
    height: 20px;
  }
  /* MENU, a key like the screen's others, as tall as the controls beside it: every tab, where some
     have left the header. */
  .menu-key {
    display: none;
    align-items: stretch;
    height: var(--ctl);
    min-width: 44px;
    margin-left: 4px;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    cursor: pointer;
  }
  .menu-key .key {
    display: inline-flex;
    align-items: center;
    padding: 0 10px;
    font-size: 1.25rem;
    line-height: 1;
  }
  .menu-key:hover .key,
  .menu-key[aria-expanded='true'] .key {
    background: var(--accent);
  }
  /* The menu drops from the header. It scrolls on its own, for a phone held sideways. */
  .menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    max-height: calc(100vh - var(--header-h));
    max-height: calc(100dvh - var(--header-h));
    overflow-y: auto;
    background: var(--bg-raised);
    border-bottom: 1px solid var(--rule);
    box-shadow: 0 30px 60px -10px rgba(0, 0, 0, 0.75);
  }
  .menu ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .menu li + li {
    border-top: 1px solid var(--rule);
  }
  /* Aligned on the right, under MENU: each tab, then its number. */
  .menu li a {
    display: flex;
    flex-direction: row-reverse;
    align-items: center;
    gap: 14px;
    min-height: 52px;
    padding: 0 var(--gutter);
    color: var(--fg);
    font-size: 1.05rem;
  }
  .menu li a:hover {
    background: var(--hover);
    color: var(--hi);
  }
  .menu .n {
    min-width: 1.5em;
    font-size: 1.4rem;
    text-align: center;
  }
  .menu a.on {
    color: var(--hi);
  }
  .menu a.on .n {
    background: var(--accent);
  }
  /* What has left the header on a phone: the option and GitHub. */
  .more {
    display: none;
    flex-direction: row-reverse;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 10px var(--gutter);
    border-top: 1px solid var(--rule);
  }
  .more .opt {
    min-height: 40px;
    padding: 2px 12px;
    font-size: 0.9rem;
  }
  .more .repo {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    color: var(--link);
  }
  /* As the header narrows, the tabs go, the home page's sections first, then all but the guide's,
     and MENU comes to hold them. */
  @media (max-width: 1240px) {
    .tabs a[data-fits='wide'] {
      display: none;
    }
    .menu-key {
      display: inline-flex;
    }
    /* Beside the header's end rather than across a whole tablet, the numbers right under MENU. */
    .menu {
      left: auto;
      right: calc(var(--gutter) - 16px);
      width: 320px;
      border: 1px solid var(--rule);
      border-top: 0;
    }
    .menu li a,
    .more {
      padding-inline: 16px;
    }
  }
  @media (min-width: 1241px) {
    .menu {
      display: none;
    }
  }
  @media (max-width: 820px) {
    .tabs a[data-fits='medium'] {
      display: none;
    }
    .top {
      --ctl: 40px;
    }
    .bar {
      gap: 14px;
    }
    .tools {
      padding-left: 14px;
    }
  }
  @media (max-width: 640px) {
    .menu {
      left: 0;
      right: 0;
      width: auto;
      border: 0;
      border-bottom: 1px solid var(--rule);
    }
    .menu li a,
    .more {
      padding-inline: var(--gutter);
    }
  }
  @media (max-width: 560px) {
    .tools .opt,
    .tools .gh {
      display: none;
    }
    .more {
      display: flex;
    }
  }
  @media (max-width: 480px) {
    .tabs {
      display: none;
    }
    .tools {
      padding-left: 0;
      border-left: 0;
    }
  }
</style>
