---
import { localized, words, type Lang } from '../i18n'

interface Props {
  lang: Lang
  path: string
}
const { lang, path } = Astro.props
const t = words(lang)
const other: Lang = lang === 'fr' ? 'en' : 'fr'
const home = localized(lang)
// The home page's sections; from a guide page, the same links lead back to them.
const onHome = path === ''
const links = [
  { id: 'fonctions', label: t.nav.features },
  { id: 'vie-privee', label: t.nav.privacy },
  { id: 'services', label: t.nav.services },
  { id: 'telecharger', label: t.nav.download }
]
---

<header class="top">
  <div class="bar wrap">
    <a class="mark" href={home} aria-label="Marianne">
      <span class="wordmark">MARIANNE</span>
    </a>
    <nav class="tabs" aria-label={lang === 'fr' ? 'Sections' : 'Sections'}>
      {links.map((l) => (
        <a href={onHome ? `#${l.id}` : `${home}#${l.id}`} data-spy={onHome ? l.id : undefined}>
          {l.label}
        </a>
      ))}
      <a href={localized(lang, 'guide/')} class:list={{ on: path.startsWith('guide/') }}>
        {t.nav.guide}
      </a>
    </nav>
    <div class="tools">
      <button type="button" class="opt" data-opt="mono" title={t.ui.monoTitle} aria-pressed="false">
        {t.ui.mono}
      </button>
      <a class="lang" href={localized(other, path)} hreflang={other} lang={other} title={t.ui.otherTitle}>
        {other.toUpperCase()}
      </a>
      <a class="gh" href="https://github.com/rodolphebarbanneau/marianne" aria-label="GitHub">
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <path
            fill="currentColor"
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
          ></path>
        </svg>
      </a>
    </div>
  </div>
</header>

<script>
  // Minitel 1, the first Minitel's greys: an option kept between visits.
  const root = document.documentElement
  const mono = document.querySelector<HTMLButtonElement>('.opt[data-opt="mono"]')!
  const read = () => {
    try {
      return !!JSON.parse(localStorage.getItem('marianne-screen') || '{}').mono
    } catch {
      return false
    }
  }
  const apply = (on: boolean) => {
    if (on) root.dataset.theme = 'monochrome'
    else delete root.dataset.theme
    mono.setAttribute('aria-pressed', String(on))
  }
  mono.addEventListener('click', () => {
    const on = !read()
    localStorage.setItem('marianne-screen', JSON.stringify({ mono: on }))
    apply(on)
  })
  apply(read())

  // The current section's tab in inverse video, as the app shows the current page.
  const tabs = [...document.querySelectorAll<HTMLAnchorElement>('[data-spy]')]
  const sections = tabs.map((a) => document.getElementById(a.dataset.spy!)).filter((s): s is HTMLElement => !!s)
  if (sections.length) {
    const update = () => {
      const y = window.scrollY + window.innerHeight * 0.35
      let current: string | undefined
      for (const s of sections) if (s.offsetTop <= y) current = s.id
      tabs.forEach((a) => a.classList.toggle('on', a.dataset.spy === current))
    }
    addEventListener('scroll', update, { passive: true })
    update()
  }
</script>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--rule);
  }
  .bar {
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .mark {
    color: var(--hi);
  }
  .mark .wordmark {
    font-size: 1.5rem;
  }
  .mark:hover .wordmark {
    color: var(--accent);
  }
  .tabs {
    display: flex;
    gap: 4px;
  }
  .tabs a {
    padding: 2px 10px;
    color: var(--dim);
  }
  .tabs a:hover {
    color: var(--hi);
  }
  .tabs a.on {
    background: var(--accent);
    color: var(--noir);
  }
  .tools {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .opt,
  .lang {
    font: inherit;
    font-size: 0.8rem;
    padding: 2px 8px;
    border: 1px dashed var(--rule);
    background: none;
    color: var(--dim);
    cursor: pointer;
  }
  .opt:hover,
  .lang:hover {
    color: var(--hi);
    border-color: var(--bleu);
  }
  .opt[aria-pressed='true'] {
    border-style: solid;
    border-color: var(--accent);
    color: var(--accent);
  }
  .lang {
    border-style: solid;
  }
  .gh {
    display: inline-flex;
    padding: 6px;
    color: var(--dim);
  }
  .gh:hover {
    color: var(--hi);
  }
  .gh svg {
    width: 20px;
    height: 20px;
  }
  @media (max-width: 560px) {
    .opt {
      display: none;
    }
  }
  @media (max-width: 820px) {
    .tabs a:not(:last-child) {
      display: none;
    }
    .bar {
      gap: 14px;
    }
  }
</style>
