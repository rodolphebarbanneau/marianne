---
import Logo from './Logo.astro'
import liberte from '../assets/liberte.png'
import { localized, nbsp, words, type Lang } from '../i18n'
import type { Release } from '../lib/release'

interface Props {
  lang: Lang
  release: Release | null
}
const { lang, release } = Astro.props
const t = words(lang)

// What people ask Marianne, typed into the composer one after the other, in French as the app is.
// The unusual and the less obvious: the routine (a toll to pay, a renewal due) comes to the user on
// its own, without asking.
const questions = [
  'Ma mère entre en maison de retraite : quelles aides pour la famille ?',
  'J’ai reçu un courrier que je ne comprends pas. Vous pouvez m’expliquer ?',
  'J’hérite d’une maison avec mon frère : par où commencer ?',
  'Je pars travailler au Portugal l’an prochain : que dois-je prévoir ?',
  'Mon propriétaire ne me rend pas ma caution. Quels sont mes recours ?',
  'Nous allons nous pacser : qu’est-ce que ça change pour nous ?',
  'Je veux créer une association de quartier : comment m’y prendre ?'
].map(nbsp)
---

<section class="hero" data-section>
  <!-- Delacroix's Liberty, as a Minitel would have shown her: a mosaic in the screen's blues. -->
  <img class="liberty" src={liberte.src} width={liberte.width * 9} height={liberte.height * 9} alt="" aria-hidden="true" />
  <canvas class="liberty" hidden aria-hidden="true"></canvas>
  <div class="wrap">
    <div class="brand">
      <Logo size={96} draw glass class="big-logo" />
      <p class="kicker wordmark">MARIANNE</p>
    </div>
    <h1>
      {t.hero.title.split('\n').map((line, i) =>
        i ? (
          <>
            <br />
            {line}
            <span class="cursor" aria-hidden="true"></span>
          </>
        ) : (
          line
        )
      )}
    </h1>
    <p class="lead">{t.hero.lead}</p>

    <div class="cta">
      <a
        class="btn primary big"
        href="#telecharger"
        data-hero-download
        data-windows={t.hero.download.windows}
        data-mac={t.hero.download.mac}
        data-linux={t.hero.download.linux}
      >
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <path d="M8 2v8m-3.5-3.5L8 10l3.5-3.5M3 13.5h10" fill="none" stroke="currentColor" stroke-width="1.6"></path>
        </svg>
        <span data-hero-label>{t.hero.download.any}</span>
      </a>
      <a class="btn big" href={localized(lang, 'guide/')}>
        {t.hero.guide}
      </a>
    </div>
    <p class="sub dim">
      <span data-hero-file>{release ? `version ${release.version}` : ''}</span>
      <span class="sep" aria-hidden="true">
        ·
      </span>
      <span>{t.hero.sub}</span>
      <span class="sep" aria-hidden="true">
        ·
      </span>
      <a href="#telecharger" data-hero-others>
        {t.hero.others}
      </a>
    </p>
    <p class="phone" data-phone hidden>
      {t.hero.phone}
    </p>

    <div class="composer" aria-hidden="true" data-questions={JSON.stringify(questions)}>
      <div class="field">
        <span class="typed"></span>
        <span class="placeholder">{t.hero.placeholder}</span>
      </div>
      <div class="foot">
        <span class="piece">+ pièce</span>
        <span class="engine">Claude Code ▾</span>
        <span class="send">{t.hero.send} ↵</span>
      </div>
    </div>
  </div>
</section>

<script>
  import { detect, ready } from '../lib/download-client'

  // Liberty's mosaic in the screen's own pixels, as the app draws its logo: a block of 8 CSS pixels and
  // a gap of 1, each rounded to whole screen pixels, so every gap is as wide as the others; drawn again
  // when the page is zoomed or the hero changes size. A phone's blocks are half that size: full size,
  // its width would show a quarter of the painting, a few blocks with nothing to recognise.
  //
  // The mosaic covers the whole hero, however wide the window: the painting in the middle, and around
  // it the same grid of blocks in its darkest level, the screen it is shown on. The painting fades into
  // that grid block by block, each block one colour, so it has no edge of its own; only the grid fades
  // into the page, at the hero's foot (its mask). The painting alone, as wide as it is, would show its
  // sides and its foot as straight bands on any window wider than it.
  const source = document.querySelector<HTMLImageElement>('img.liberty')!
  const canvas = document.querySelector<HTMLCanvasElement>('canvas.liberty')!
  const hero = canvas.parentElement!
  // A ramp eased at both ends, so a fade has no line where it starts or where it ends.
  const ease = (gradient: CanvasGradient, from: number, to: number, rising: boolean) => {
    for (let i = 0; i <= 8; i++) {
      const t = i / 8
      const v = t * t * (3 - 2 * t)
      gradient.addColorStop(from + (to - from) * t, `rgba(0, 0, 0, ${rising ? v : 1 - v})`)
    }
  }
  // The painting at one pixel a block, its sides and its foot fading out, and its darkest level.
  let painting: { art: HTMLCanvasElement; dark: string } | undefined
  const paint = () => {
    const { naturalWidth: cols, naturalHeight: rows } = source
    const art = document.createElement('canvas')
    art.width = cols
    art.height = rows
    const ctx = art.getContext('2d')!
    ctx.drawImage(source, 0, 0)
    const data = ctx.getImageData(0, 0, cols, rows).data
    const level = (i: number) => data[i] + data[i + 1] + data[i + 2]
    let darkest = 0
    for (let i = 4; i < data.length; i += 4) if (level(i) < level(darkest)) darkest = i
    const dark = `rgb(${data[darkest]}, ${data[darkest + 1]}, ${data[darkest + 2]})`
    // Over 15 % of its width at each side and its lower half, as the image alone fades.
    const side = 0.15
    const across = ctx.createLinearGradient(0, 0, cols, 0)
    ease(across, 0, side, true)
    ease(across, 1 - side, 1, false)
    const down = ctx.createLinearGradient(0, 0, 0, rows)
    ease(down, 0.5, 1, false)
    ctx.globalCompositeOperation = 'destination-in'
    ctx.fillStyle = across
    ctx.fillRect(0, 0, cols, rows)
    ctx.fillStyle = down
    ctx.fillRect(0, 0, cols, rows)
    return { art, dark }
  }
  const drawLiberty = () => {
    painting ??= paint()
    const dpr = window.devicePixelRatio || 1
    const size = matchMedia('(max-width: 640px)').matches ? 0.5 : 1
    const block = Math.max(2, Math.round(8 * size * dpr))
    const gap = Math.max(1, Math.round(size * dpr))
    const step = block + gap
    const width = Math.round(hero.clientWidth * dpr)
    const height = Math.round(hero.clientHeight * dpr)
    // The painting centred on a whole screen pixel, and the grid's columns in step with its own: the
    // first is the one at the hero's left edge, left of the painting's first on a wide window.
    const left = Math.round((width - painting.art.width * step) / 2)
    const first = Math.floor(-left / step)
    const cols = Math.ceil((width - left) / step) - first
    const rows = Math.ceil(height / step)
    const grid = document.createElement('canvas')
    grid.width = cols
    grid.height = rows
    const small = grid.getContext('2d')!
    small.fillStyle = painting.dark
    small.fillRect(0, 0, cols, rows)
    small.drawImage(painting.art, -first, 0)
    canvas.width = width
    canvas.height = height
    canvas.style.width = `${width / dpr}px`
    canvas.style.height = `${height / dpr}px`
    const ctx = canvas.getContext('2d')!
    ctx.imageSmoothingEnabled = false
    ctx.drawImage(grid, left + first * step, 0, cols * step, rows * step)
    ctx.fillStyle = '#05071a'
    for (let x = 0; x < cols; x++) ctx.fillRect(left + (first + x) * step + block, 0, gap, height)
    for (let y = 0; y < rows; y++) ctx.fillRect(0, y * step + block, width, gap)
    canvas.hidden = false
    source.hidden = true
  }
  const loaded = () => source.complete && source.naturalWidth > 0
  const watchZoom = () =>
    matchMedia(`(resolution: ${window.devicePixelRatio}dppx)`).addEventListener('change', () => (loaded() && drawLiberty(), watchZoom()), { once: true })
  if (!loaded()) source.addEventListener('load', drawLiberty, { once: true })
  new ResizeObserver(() => loaded() && drawLiberty()).observe(hero)
  watchZoom()
  import { megabytes } from '../lib/release'

  // The download button, for the visitor's system once the release is known.
  ready((release, lang) => {
    const os = detect()
    const btn = document.querySelector<HTMLAnchorElement>('[data-hero-download]')!
    const label = document.querySelector('[data-hero-label]')!
    const file = document.querySelector('[data-hero-file]')!
    if (os.kind === 'mobile') {
      document.querySelector<HTMLElement>('[data-phone]')!.hidden = false
      return
    }
    if (!os.kind) return
    label.textContent = btn.dataset[os.kind]!
    const asset = release?.assets[os.installer!]
    if (asset) {
      btn.href = asset.url
      file.textContent = `${asset.name} · ${megabytes(asset.size, lang)}`
    }
  })

  // The composer types what people ask, sends it, and starts again; still when out of sight.
  const box = document.querySelector<HTMLElement>('.composer')!
  const typed = box.querySelector('.typed')!
  const questions: string[] = JSON.parse(box.dataset.questions!)
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches
  let visible = true
  new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(box)
  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms))
  const awake = async () => {
    while (!visible || document.hidden) await wait(400)
  }
  if (still) {
    typed.textContent = questions[0]
    box.classList.add('filled')
  } else {
    ;(async () => {
      await wait(1500)
      for (let n = 0; ; n = (n + 1) % questions.length) {
        const q = questions[n]
        box.classList.add('filled')
        for (let i = 1; i <= q.length; i++) {
          await awake()
          typed.textContent = q.slice(0, i)
          await wait(q[i - 1] === ' ' ? 55 : 22 + Math.random() * 40)
        }
        await wait(1400)
        box.classList.add('sending')
        await wait(450)
        box.classList.remove('sending', 'filled')
        typed.textContent = ''
        await wait(700)
      }
    })()
  }
</script>

<style>
  .hero {
    padding: clamp(40px, 6vw, 64px) 0 0;
    text-align: center;
    position: relative;
    overflow-x: clip;
  }
  /* A blue glow behind the mark, like a screen warming up. */
  .hero::before {
    content: '';
    position: absolute;
    inset: -60px 0 auto;
    height: 640px;
    background: radial-gradient(ellipse 48% 60% at 50% 20%, rgba(61, 90, 254, 0.22), transparent 70%);
    pointer-events: none;
  }
  /* La Liberté guidant le peuple (Delacroix, 1830), in mosaic blocks of the site's blues (made from the
     Louvre's painting, public domain): behind the whole hero, dim, Liberty and her flag behind the mark
     and the title. Its blocks are opaque, dimmed in their colours, so the page's dot matrix stays behind
     them. The image holds one pixel per block; the script draws the mosaic on a canvas in the screen's
     own pixels, blocks and gaps whole pixels at any scale (an image scaled to 125 % would draw its 1px
     gaps 1 or 2 pixels wide, a thicker line every 4 blocks), across the whole hero, the painting fading
     into a grid of its darkest blocks; the canvas fades into the page at the hero's foot, eased, over
     the composer's height and more. Without the script, the image alone, without its gaps, fading at
     its own edges. */
  .liberty {
    position: absolute;
    top: 0;
    max-width: none;
    pointer-events: none;
  }
  img.liberty {
    left: 50%;
    width: 1440px;
    height: auto;
    translate: -50% 0;
    image-rendering: pixelated;
    -webkit-mask-image: linear-gradient(to bottom, #000 50%, transparent 100%), linear-gradient(to right, transparent, #000 15%, #000 85%, transparent);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to bottom, #000 50%, transparent 100%), linear-gradient(to right, transparent, #000 15%, #000 85%, transparent);
    mask-composite: intersect;
  }
  canvas.liberty {
    left: 0;
    --fade: linear-gradient(
      to bottom,
      #000 calc(100% - 320px),
      rgba(0, 0, 0, 0.84) calc(100% - 240px),
      rgba(0, 0, 0, 0.5) calc(100% - 160px),
      rgba(0, 0, 0, 0.16) calc(100% - 80px),
      transparent
    );
    -webkit-mask-image: var(--fade);
    mask-image: var(--fade);
  }
  :global(html[data-theme='monochrome']) .liberty {
    filter: grayscale(1);
  }
  .wrap {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .brand :global(.big-logo) {
    box-shadow: 0 20px 60px -10px rgba(61, 90, 254, 0.45);
  }
  .kicker {
    font-size: 1.6rem;
  }
  h1 {
    margin-top: 26px;
    font-family: var(--retro);
    font-size: clamp(2.7rem, 7vw, 5.5rem);
    line-height: 0.95;
    color: var(--hi);
    text-wrap: balance;
  }
  /* The screen's cursor, a block nearly the height of the title's letters, after its last word. */
  h1 .cursor {
    width: 0.38em;
    height: 0.66em;
    margin-left: 0.14em;
    vertical-align: -0.08em;
  }
  .lead {
    margin-top: 22px;
    max-width: 62ch;
    font-size: clamp(1rem, 1.6vw, 1.12rem);
    color: var(--fg);
    text-wrap: pretty;
  }

  /* The app's composer, as on its home page, typing what people ask. */
  .composer {
    margin-top: 56px;
    width: min(760px, 100%);
    text-align: left;
    background: var(--bg-raised);
    border: 1px solid var(--fg);
    padding: 14px 16px 12px;
    box-shadow: 0 24px 80px -24px rgba(61, 90, 254, 0.5);
  }
  .field {
    min-height: 3.2em;
    color: var(--hi);
    line-height: 1.6;
  }
  .placeholder {
    color: var(--muted);
  }
  .composer.filled .placeholder {
    display: none;
  }
  /* The cursor, right after the last letter typed. */
  .composer.filled .typed::after {
    content: '';
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    vertical-align: -0.18em;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }
  .foot {
    margin-top: 10px;
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .piece {
    color: var(--link);
  }
  .engine {
    margin-left: auto;
    color: var(--dim);
  }
  .send {
    padding: 4px 12px;
    background: color-mix(in srgb, var(--accent) 30%, var(--bg-raised));
    color: color-mix(in srgb, var(--noir) 80%, var(--accent));
    transition: background 0.15s;
  }
  .composer.filled .send {
    background: var(--accent);
    color: var(--noir);
  }
  .composer.sending .send {
    background: var(--blanc);
  }
  .composer.sending .typed {
    color: var(--accent);
  }

  .cta {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
  .sub {
    margin-top: 16px;
    font-size: 0.86rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px 10px;
  }
  .sub [data-hero-file]:empty + .sep {
    display: none;
  }
  @media (max-width: 640px) {
    .sub {
      flex-direction: column;
      gap: 2px;
    }
    .sub .sep {
      display: none;
    }
    .sub a {
      padding: 6px 0;
    }
    img.liberty {
      width: 720px;
    }
  }
  .phone {
    margin-top: 14px;
    color: var(--accent);
  }
  @media (max-width: 560px) {
    .engine {
      display: none;
    }
    .send {
      margin-left: auto;
    }
  }
</style>
