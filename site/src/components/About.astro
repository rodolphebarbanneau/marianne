---
import TextPage from './TextPage.astro'
import { localized, words, type Lang } from '../i18n'
// The authors as the app names them (GUIDE, Réglages › À propos): the repository's contributors on
// GitHub, its owner first, as apps/desktop/scripts/contributors.mjs writes them. Read from the
// repository, as the guide is: one list, never copied.
import contributors from '../../../apps/desktop/src/shared/contributors.json'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = words(lang)
const a = t.about
const GH = 'https://github.com/rodolphebarbanneau/marianne'
---

<TextPage lang={lang} path="a-propos/" title={a.title} description={a.description} code="MARIANNE" heading={a.heading} lead={a.lead}>
  <section data-section>
    <h2>{a.app.title}</h2>
    {a.app.text.map((p) => (
      <p>{p}</p>
    ))}
  </section>
  <section data-section>
    <h2>{a.independent.title}</h2>
    {a.independent.text.map((p) => (
      <p>{p}</p>
    ))}
  </section>
  <section data-section>
    <h2>{a.authors.title}</h2>
    <p>{a.authors.lead}</p>
    <ul class="authors">
      {contributors.map((c) => (
        <li>
          <a href={c.url}>{c.name}</a> <span class="dim">@{c.login}</span>
        </li>
      ))}
    </ul>
    {a.authors.text.map((p) => (
      <p>{p}</p>
    ))}
    <p class="go">
      <a class="btn" href={`${GH}/blob/main/CONTRIBUTING.md`}>
        {a.authors.contribute} ›
      </a>
      <a class="btn" href={`${GH}/graphs/contributors`}>
        {a.authors.all} ›
      </a>
      <a class="btn" href={`${GH}/issues/new/choose`}>
        {t.footer.issues} ›
      </a>
    </p>
  </section>
  <section data-section>
    <h2>{a.license.title}</h2>
    {a.license.text.map((p) => (
      <p>{p}</p>
    ))}
    <p class="go">
      <a class="btn" href={`${GH}/blob/main/LICENSE`}>
        {t.footer.license} ›
      </a>
      <a class="btn" href={`${GH}/blob/main/SECURITY.md`}>
        {t.footer.security} ›
      </a>
    </p>
  </section>
  <section>
    <p>
      <a class="btn primary" href={localized(lang, 'manifeste/')}>
        {a.why} ›
      </a>
    </p>
  </section>
</TextPage>

<style>
  .authors {
    list-style: none;
    margin: 0 0 20px;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .authors li {
    display: flex;
    gap: 12px;
    align-items: baseline;
    padding: 10px 14px;
    background: var(--bg-raised);
    border: 1px solid var(--rule);
  }
  .authors a {
    color: var(--hi);
  }
  .authors a:hover {
    color: var(--accent);
  }
  .go {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 22px;
  }
</style>
