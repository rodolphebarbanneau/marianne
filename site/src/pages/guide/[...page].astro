---
import GuidePage from '../../components/GuidePage.astro'
import { guidePages } from '../../lib/guide'

export async function getStaticPaths() {
  const pages = await guidePages('fr')
  return pages.map((page) => ({ params: { page: page.slug || undefined }, props: { pages, page } }))
}
const { pages, page } = Astro.props
---

<GuidePage lang="fr" pages={pages} page={page} />
