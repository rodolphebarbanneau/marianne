{
  "name": "marianne",
  "productName": "Marianne",
  "version": "0.1.0",
  "description": "Assistant citoyen : vos droits, vos démarches et les données publiques françaises, avec votre propre Claude Code ou Codex.",
  "main": "./out/main/index.js",
  "author": "Rodolphe Barbanneau",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rodolphebarbanneau/marianne.git"
  },
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test",
    "icons": "node scripts/generate-icons.mjs",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "electron-updater": "^6.8.11",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "pdfjs-dist": "^6.4.299",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "hls.js": "^1.7.3",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
