{
  "name": "marianne-workspace",
  "description": "Marianne: the desktop app (apps/desktop), its packages (packages: the SDK, the archive, the profile, the content) and its built-in services (services).",
  "author": "Rodolphe Barbanneau",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rodolphebarbanneau/marianne.git"
  },
  "private": true,
  "scripts": {
    "dev": "npm run dev -w marianne",
    "build": "npm run build -w marianne",
    "start": "npm run start -w marianne",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && node scripts/check-gitkeep.mjs && node scripts/check-boundaries.mjs && npm run typecheck && npm test",
    "icons": "npm run icons -w marianne",
    "content:bundle": "npm run bundle -w @marianne/content",
    "content:key": "npm run key -w @marianne/content --",
    "dist": "npm run dist -w marianne",
    "dist:dir": "npm run dist:dir -w marianne"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ]
}
