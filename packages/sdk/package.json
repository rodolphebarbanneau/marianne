{
  "name": "@marianne/sdk",
  "version": "0.1.0",
  "description": "Build services for Marianne: the manifest, the contracts of their main-process side, background sync and window view, and a fake context for their tests.",
  "license": "MIT",
  "author": "Rodolphe Barbanneau",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./main": "./src/main.ts",
    "./media": "./src/media/index.ts",
    "./pack": "./scripts/pack.mjs",
    "./sync": "./src/sync.ts",
    "./testing": "./src/testing.ts",
    "./view": "./src/view.tsx"
  },
  "bin": {
    "marianne-pack": "./scripts/pack.mjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p examples/bonjour",
    "test": "vitest run"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "hls.js": "^1.7.3",
    "vite": "^8.3.5"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  }
}
