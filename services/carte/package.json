        ".bbbrbb.",
        "..bbbbb.",
        "..bbbb.b",
        "...bb..b"
      ]
    },
    "tools": [
      {
        "name": "figures",
        "label": "chiffres"
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@marianne/sdk": "*",
    "react": "^19.0.0",
    "zod": "^4.0.0"
