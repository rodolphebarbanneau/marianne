{
  "name": "@marianne/service-carte",
  "version": "1.0.0",
  "description": "3615 CARTE · Carte de France : départements et communes : population, superficie, densité",
  "license": "MIT",
  "author": "Rodolphe Barbanneau",
  "private": true,
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./main": "./src/main.ts",
    "./view": "./src/view.tsx",
    "./help": "./src/help.md"
  },
  "marianne": {
    "code": "carte",
    "name": "Carte de France",
